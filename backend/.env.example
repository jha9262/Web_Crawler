# ============================================================
# Backend Environment Variables — copy this to .env for local dev
# NEVER commit real secrets to version control
# ============================================================

# --- Database (MongoDB) ---
MONGODB_URI=mongodb+srv://Nitish:<Nitish@9065>@webcrawl.tjepe0o.mongodb.net/?appName=WebCrawl

# --- JWT ---
# Must be at least 64 characters long
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_64_CHARACTERS_LONG_XXXXX
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
PORT=8080
